{
  "$schema": "https://schema.tauri.app/config/2/capability.json",
  "identifier": "mcp-bridge",
  "description": "Opt-in MCP bridge folder (.hades-bridge) inside the sync folder. The default capability's ** scope never matches dot-prefixed folders on macOS and Linux, so this folder needs its own entries.",
  "platforms": ["linux", "macOS", "windows"],
  "windows": ["main"],
  "permissions": [
    {
      "identifier": "fs:allow-mkdir",
      "allow": [{ "path": "**/.hades-bridge" }, { "path": "**/.hades-bridge/**" }]
    },
    {
      "identifier": "fs:allow-write-text-file",
      "allow": [{ "path": "**/.hades-bridge/**" }]
    },
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [{ "path": "**/.hades-bridge/**" }]
    },
    {
      "identifier": "fs:allow-read-dir",
      "allow": [{ "path": "**/.hades-bridge/**" }]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [{ "path": "**/.hades-bridge/**" }]
    },
    {
      "identifier": "fs:allow-rename",
      "allow": [{ "path": "**/.hades-bridge/**" }]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [{ "path": "**/.hades-bridge" }, { "path": "**/.hades-bridge/**" }]
    }
  ]
}
